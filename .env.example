# ===== AI 网关服务 =====
PORT=8787
# 管理接口(/v1/admin/*)使用的令牌
ADMIN_TOKEN=change-me-admin-token

# ===== PostgreSQL (docker compose 提供) =====
DATABASE_URL=postgres://aics:aics@localhost:5433/aics

# ===== Milvus (docker compose 提供) =====
# Milvus 2.5 起 RESTful v2 API 与 gRPC 同端口，必须指向 19530（9091 仅剩 /healthz）
MILVUS_ADDRESS=http://localhost:19530
# 如 Milvus 开启了鉴权填 root:Milvus
MILVUS_TOKEN=

# ===== 上游大模型 (OpenAI 兼容, 支持多上游 fallback, JSON 数组) =====
# 每个上游: { "name", "baseUrl", "apiKey", "model" }
# 内置虚拟提供者 "mock"（name 含 mock 即启用），用于无 Key 离线开发验证
LLM_UPSTREAMS=[{"name":"mock","baseUrl":"mock://","apiKey":"mock","model":"mock-chat"}]
# 模型路由: 哪个任务用哪个上游（留空则用第一个上游）
# 示例: {"default":"mock","draft":"mock","review":"mock"}
LLM_MODEL_ROUTING={}

# ===== 上游 Embedding (OpenAI 兼容 /v1/embeddings) =====
# 留空使用内置 mock embedding（确定性哈希向量, 1024 维, 仅用于开发验证）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 必须与 Embedding 模型真实维度一致（智谱 embedding-3=2048, OpenAI text-embedding-3-small=1536）
EMBEDDING_DIM=1024

# ===== 语义缓存 =====
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92
# ===== 限流默认值 (每 API Key) =====
RATE_LIMIT_RPM=60
RATE_LIMIT_TPM=100000
